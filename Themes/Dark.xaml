<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- v3 Violet palette — deep navy base, purple accent per Apr-23 mockup -->
    <Color x:Key="BackgroundColor">#0B1020</Color>           <!-- deepest navy, window bg -->
    <Color x:Key="SurfaceColor">#1A2045</Color>              <!-- card surface -->
    <Color x:Key="SurfaceRaisedColor">#1F2550</Color>        <!-- raised panels -->
    <Color x:Key="SurfaceInsetColor">#121735</Color>         <!-- inset / sidebar -->
    <Color x:Key="PanelColor">#121735</Color>                <!-- sidebar + side panels -->
    <Color x:Key="BorderColor">#1F2550</Color>
    <Color x:Key="BorderStrongColor">#2A3068</Color>
    <Color x:Key="PrimaryTextColor">#E8E8EC</Color>
    <Color x:Key="SecondaryTextColor">#9AA1D3</Color>        <!-- labels, sidebar drive subtitles (mockup text-dim) -->
    <Color x:Key="TertiaryTextColor">#8A90C7</Color>         <!-- fine-print meta text (mockup text-mute) -->
    <Color x:Key="AccentColor">#7C5CFF</Color>               <!-- violet accent -->
    <Color x:Key="AccentHoverColor">#9F7CFF</Color>          <!-- lighter violet on hover -->
    <Color x:Key="AccentDimColor">#15103A</Color>
    <Color x:Key="SelectionColor">#2A1E5E</Color>            <!-- violet-tinted selection -->
    <Color x:Key="HoverColor">#262C60</Color>                <!-- sidebar/card hover -->
    <Color x:Key="ToolbarColor">#121735</Color>
    <Color x:Key="SuccessColor">#4ADE80</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="DangerColor">#F87171</Color>
    <Color x:Key="RowAltColor">#141A38</Color>
    <Color x:Key="ProgressTrackColor">#1F2550</Color>

    <!-- SRC / DST pane accent colors (kept semantic: blue=source, green=destination) -->
    <Color x:Key="PaneSrcBorderColor">#5A4AD4</Color>        <!-- shifted toward violet family -->
    <Color x:Key="PaneSrcBgColor">#141036</Color>
    <Color x:Key="PaneDstBorderColor">#2D8A50</Color>
    <Color x:Key="PaneDstBgColor">#142218</Color>

    <!-- ============================================================================
         Dashboard + crash-banner tokens (Wave 2.1).
         These used to be hard-coded hex literals in MainWindow.xaml, which meant the
         home dashboard stayed dark-mode-coloured even in light theme. Every DARK value
         below is the EXACT literal that was previously inline, so dark mode renders
         identically to before this change; only Light.xaml's values are new.
         ============================================================================ -->

    <!-- Card outline. Note this is NOT BorderColor: the dashboard cards use a
         violet-tinted outline that is deliberately stronger than the generic border. -->
    <Color x:Key="CardBorderColor">#3A3075</Color>

    <!-- Crash-recovery banner (amber "previous session ended uncleanly" strip). -->
    <Color x:Key="BannerWarnBgColor">#3A2A1A</Color>
    <Color x:Key="BannerWarnBorderColor">#D49A2A</Color>
    <!-- Icon is its own token, not shared with the border: on a LIGHT amber background
         the border tint is too pale to read as a warning glyph, so light mode needs a
         darker amber here. Both dark values are the same literal, so dark is unchanged. -->
    <Color x:Key="BannerWarnIconColor">#D49A2A</Color>
    <Color x:Key="BannerWarnTextColor">#F0D08A</Color>

    <!-- "You are protected" status banner (green) and its At-Risk counterpart (red).
         Fg = the saturated shield/triangle + headline colour; Accent = the slightly
         lighter green used by the summary check-marks and the schedule-enabled dot.
         They are separate tokens only because they are two DIFFERENT dark hexes;
         collapsing them would change dark rendering. -->
    <Color x:Key="StatusOkBgColor">#0A2519</Color>
    <Color x:Key="StatusOkBorderColor">#1E5140</Color>
    <Color x:Key="StatusOkFgColor">#3DD68C</Color>
    <Color x:Key="StatusOkAccentColor">#5AE0A4</Color>
    <Color x:Key="StatusRiskBgColor">#1A0507</Color>
    <Color x:Key="StatusRiskBorderColor">#6E070A</Color>
    <Color x:Key="StatusRiskFgColor">#E04E5C</Color>

    <!-- Text that dark mode deliberately renders PURE white (not PrimaryTextColor's
         #E8E8EC) for extra punch on a tinted/!chrome surface: the status-banner body,
         the card action rows, the app title. Was literal White everywhere — correct on
         dark, invisible on light (the light toolbar is #F4F4F9, the light banner a pale
         wash). Kept at #FFFFFF here so dark is byte-identical. -->
    <Color x:Key="EmphasisTextColor">#FFFFFF</Color>
    <!-- Outline of the banner's "View details" button (transparent fill). -->
    <Color x:Key="StatusActionBorderColor">#3A5249</Color>

    <!-- Status pills: a 10%-alpha wash of the status colour (#1A = 10% alpha) behind a
         state dot/glyph. Used by BOTH the schedule card's enabled/disabled pill and the
         recent-backups list's per-row status dot, so these are named for the pattern,
         not for one card. Light values are the light theme's success/danger hues at the
         same alpha. -->
    <Color x:Key="StatusPillOkBgColor">#1A5AE0A4</Color>
    <Color x:Key="StatusPillRiskBgColor">#1AF87171</Color>
    <Color x:Key="ScheduleIconColor">#F0B860</Color>

    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}"/>
    <SolidColorBrush x:Key="BannerWarnBgBrush" Color="{StaticResource BannerWarnBgColor}"/>
    <SolidColorBrush x:Key="BannerWarnBorderBrush" Color="{StaticResource BannerWarnBorderColor}"/>
    <SolidColorBrush x:Key="BannerWarnIconBrush" Color="{StaticResource BannerWarnIconColor}"/>
    <SolidColorBrush x:Key="BannerWarnTextBrush" Color="{StaticResource BannerWarnTextColor}"/>
    <SolidColorBrush x:Key="StatusOkBgBrush" Color="{StaticResource StatusOkBgColor}"/>
    <SolidColorBrush x:Key="StatusOkBorderBrush" Color="{StaticResource StatusOkBorderColor}"/>
    <SolidColorBrush x:Key="StatusOkFgBrush" Color="{StaticResource StatusOkFgColor}"/>
    <SolidColorBrush x:Key="StatusOkAccentBrush" Color="{StaticResource StatusOkAccentColor}"/>
    <SolidColorBrush x:Key="StatusRiskBgBrush" Color="{StaticResource StatusRiskBgColor}"/>
    <SolidColorBrush x:Key="StatusRiskBorderBrush" Color="{StaticResource StatusRiskBorderColor}"/>
    <SolidColorBrush x:Key="StatusRiskFgBrush" Color="{StaticResource StatusRiskFgColor}"/>
    <SolidColorBrush x:Key="EmphasisTextBrush" Color="{StaticResource EmphasisTextColor}"/>
    <SolidColorBrush x:Key="StatusActionBorderBrush" Color="{StaticResource StatusActionBorderColor}"/>
    <SolidColorBrush x:Key="StatusPillOkBgBrush" Color="{StaticResource StatusPillOkBgColor}"/>
    <SolidColorBrush x:Key="StatusPillRiskBgBrush" Color="{StaticResource StatusPillRiskBgColor}"/>
    <SolidColorBrush x:Key="ScheduleIconBrush" Color="{StaticResource ScheduleIconColor}"/>

    <!-- Dedicated overrides (dark mode uses existing semantic values) -->
    <Color x:Key="ToggleTrackOffColor">#2A3068</Color>
    <Color x:Key="RingTrackColor">#1F2550</Color>
    <Color x:Key="DonutCenterColor">#121735</Color>

    <SolidColorBrush x:Key="ToggleTrackOffBrush" Color="{StaticResource ToggleTrackOffColor}"/>
    <SolidColorBrush x:Key="RingTrackBrush" Color="{StaticResource RingTrackColor}"/>
    <SolidColorBrush x:Key="DonutCenterBrush" Color="{StaticResource DonutCenterColor}"/>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}"/>
    <SolidColorBrush x:Key="SurfaceInsetBrush" Color="{StaticResource SurfaceInsetColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="{StaticResource TertiaryTextColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="ToolbarBrush" Color="{StaticResource ToolbarColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="RowAltBrush" Color="{StaticResource RowAltColor}"/>
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="{StaticResource ProgressTrackColor}"/>
    <SolidColorBrush x:Key="PaneSrcBorderBrush" Color="{StaticResource PaneSrcBorderColor}"/>
    <SolidColorBrush x:Key="PaneSrcBgBrush" Color="{StaticResource PaneSrcBgColor}"/>
    <SolidColorBrush x:Key="PaneDstBorderBrush" Color="{StaticResource PaneDstBorderColor}"/>
    <SolidColorBrush x:Key="PaneDstBgBrush" Color="{StaticResource PaneDstBgColor}"/>

</ResourceDictionary>
