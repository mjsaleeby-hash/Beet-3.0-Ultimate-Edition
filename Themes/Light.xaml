<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- v3 Light mode polish — warm gray base, stronger contrast -->
    <Color x:Key="BackgroundColor">#F2F2EF</Color>          <!-- #2: warm gray base instead of flat blue-gray -->
    <Color x:Key="SurfaceColor">#FFFFFF</Color>              <!-- pure white panels for depth contrast -->
    <Color x:Key="SurfaceRaisedColor">#F7F7FC</Color>
    <Color x:Key="SurfaceInsetColor">#EEEEF4</Color>
    <Color x:Key="PanelColor">#F0F0F5</Color>
    <Color x:Key="BorderColor">#DDDDE4</Color>
    <Color x:Key="BorderStrongColor">#ABABBC</Color>        <!-- toggle track off-state + borders -->
    <Color x:Key="PrimaryTextColor">#111111</Color>         <!-- #3: darkened for sidebar drive names -->
    <Color x:Key="SecondaryTextColor">#555555</Color>       <!-- #3: darkened for storage figures -->
    <Color x:Key="TertiaryTextColor">#888898</Color>        <!-- DRIVES label visible -->
    <Color x:Key="AccentColor">#7C5CFF</Color>             <!-- v3: violet accent (was #4A9EFF blue) -->
    <Color x:Key="AccentHoverColor">#5B3EE0</Color>        <!-- deeper violet on hover -->
    <Color x:Key="AccentDimColor">#EDE8FC</Color>          <!-- violet-tinted dim -->
    <Color x:Key="SelectionColor">#E0D7FA</Color>          <!-- violet-tinted selection highlight -->
    <Color x:Key="HoverColor">#D0DEF0</Color>
    <Color x:Key="ToolbarColor">#F4F4F9</Color>
    <Color x:Key="SuccessColor">#148C3E</Color>             <!-- #7: deepened green for 4.5:1 contrast on white -->
    <Color x:Key="WarningColor">#D97706</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="RowAltColor">#F8F8FC</Color>
    <Color x:Key="ProgressTrackColor">#CCCCCC</Color>       <!-- ring track + progress bar visible on light panels -->

    <!-- SRC / DST pane accent colors -->
    <Color x:Key="PaneSrcBorderColor">#A094F0</Color>      <!-- violet family -->
    <Color x:Key="PaneSrcBgColor">#F3F0FF</Color>
    <Color x:Key="PaneDstBorderColor">#4DB878</Color>       <!-- #7: deeper green border for contrast -->
    <Color x:Key="PaneDstBgColor">#EEFBF2</Color>

    <!-- ============================================================================
         Dashboard + crash-banner tokens (Wave 2.1) — the light half.
         Dark.xaml documents what each token is for. These values are NEW (the dashboard
         previously hard-coded dark hexes and so ignored the light theme entirely).
         Rule followed here: any colour carrying TEXT or an ICON is deepened to hold at
         least ~4.5:1 against the surface it sits on, matching the existing intent in
         SuccessColor (:21) and PaneDstBorderColor (:30).
         ============================================================================ -->

    <!-- Cards: the dark theme's violet outline becomes the standard light border —
         a violet-tinted line on white reads as a smudge rather than an edge. -->
    <Color x:Key="CardBorderColor">#DDDDE4</Color>

    <!-- Crash banner: pale amber wash, with border/icon/text deepening in that order
         so the strip reads as a warning without shouting. -->
    <Color x:Key="BannerWarnBgColor">#FDF4E3</Color>
    <Color x:Key="BannerWarnBorderColor">#E0A93A</Color>
    <Color x:Key="BannerWarnIconColor">#B45309</Color>    <!-- deepened: the glyph must read on #FDF4E3 -->
    <Color x:Key="BannerWarnTextColor">#8A5A00</Color>

    <!-- Status banner: pale tint backgrounds; foregrounds reuse the light theme's
         already-contrast-checked success/danger hues rather than inventing new ones. -->
    <Color x:Key="StatusOkBgColor">#EAFBF1</Color>
    <Color x:Key="StatusOkBorderColor">#A8DCC0</Color>
    <Color x:Key="StatusOkFgColor">#148C3E</Color>        <!-- = SuccessColor, 4.5:1 on white -->
    <Color x:Key="StatusOkAccentColor">#148C3E</Color>    <!-- dark's two greens converge in light -->
    <Color x:Key="StatusRiskBgColor">#FDECEC</Color>
    <Color x:Key="StatusRiskBorderColor">#F3B7B7</Color>
    <Color x:Key="StatusRiskFgColor">#C62828</Color>

    <!-- Near-black, since every surface this sits on is pale in light mode. Matches
         PrimaryTextColor's value, but stays a separate token because dark needs pure
         #FFFFFF here rather than PrimaryTextColor's softer #E8E8EC. -->
    <Color x:Key="EmphasisTextColor">#111111</Color>
    <Color x:Key="StatusActionBorderColor">#B8CFC2</Color>

    <Color x:Key="StatusPillOkBgColor">#1A148C3E</Color>    <!-- 10% alpha of SuccessColor -->
    <Color x:Key="StatusPillRiskBgColor">#1ADC2626</Color>  <!-- 10% alpha of DangerColor -->
    <Color x:Key="ScheduleIconColor">#B45309</Color>

    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}"/>
    <SolidColorBrush x:Key="BannerWarnBgBrush" Color="{StaticResource BannerWarnBgColor}"/>
    <SolidColorBrush x:Key="BannerWarnBorderBrush" Color="{StaticResource BannerWarnBorderColor}"/>
    <SolidColorBrush x:Key="BannerWarnIconBrush" Color="{StaticResource BannerWarnIconColor}"/>
    <SolidColorBrush x:Key="BannerWarnTextBrush" Color="{StaticResource BannerWarnTextColor}"/>
    <SolidColorBrush x:Key="StatusOkBgBrush" Color="{StaticResource StatusOkBgColor}"/>
    <SolidColorBrush x:Key="StatusOkBorderBrush" Color="{StaticResource StatusOkBorderColor}"/>
    <SolidColorBrush x:Key="StatusOkFgBrush" Color="{StaticResource StatusOkFgColor}"/>
    <SolidColorBrush x:Key="StatusOkAccentBrush" Color="{StaticResource StatusOkAccentColor}"/>
    <SolidColorBrush x:Key="StatusRiskBgBrush" Color="{StaticResource StatusRiskBgColor}"/>
    <SolidColorBrush x:Key="StatusRiskBorderBrush" Color="{StaticResource StatusRiskBorderColor}"/>
    <SolidColorBrush x:Key="StatusRiskFgBrush" Color="{StaticResource StatusRiskFgColor}"/>
    <SolidColorBrush x:Key="EmphasisTextBrush" Color="{StaticResource EmphasisTextColor}"/>
    <SolidColorBrush x:Key="StatusActionBorderBrush" Color="{StaticResource StatusActionBorderColor}"/>
    <SolidColorBrush x:Key="StatusPillOkBgBrush" Color="{StaticResource StatusPillOkBgColor}"/>
    <SolidColorBrush x:Key="StatusPillRiskBgBrush" Color="{StaticResource StatusPillRiskBgColor}"/>
    <SolidColorBrush x:Key="ScheduleIconBrush" Color="{StaticResource ScheduleIconColor}"/>

    <!-- Dedicated overrides for stubborn light-mode elements -->
    <Color x:Key="ToggleTrackOffColor">#BBBBBB</Color>     <!-- toggle off-state track -->
    <Color x:Key="RingTrackColor">#D0D0D0</Color>          <!-- drive usage ring empty arc -->
    <Color x:Key="DonutCenterColor">#FFFFFF</Color>        <!-- pie chart center hole: matches SurfaceColor so the hole reads as a cut-out, not a disc -->

    <SolidColorBrush x:Key="ToggleTrackOffBrush" Color="{StaticResource ToggleTrackOffColor}"/>
    <SolidColorBrush x:Key="RingTrackBrush" Color="{StaticResource RingTrackColor}"/>
    <SolidColorBrush x:Key="DonutCenterBrush" Color="{StaticResource DonutCenterColor}"/>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}"/>
    <SolidColorBrush x:Key="SurfaceInsetBrush" Color="{StaticResource SurfaceInsetColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="{StaticResource TertiaryTextColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="ToolbarBrush" Color="{StaticResource ToolbarColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="RowAltBrush" Color="{StaticResource RowAltColor}"/>
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="{StaticResource ProgressTrackColor}"/>
    <SolidColorBrush x:Key="PaneSrcBorderBrush" Color="{StaticResource PaneSrcBorderColor}"/>
    <SolidColorBrush x:Key="PaneSrcBgBrush" Color="{StaticResource PaneSrcBgColor}"/>
    <SolidColorBrush x:Key="PaneDstBorderBrush" Color="{StaticResource PaneDstBorderColor}"/>
    <SolidColorBrush x:Key="PaneDstBgBrush" Color="{StaticResource PaneDstBgColor}"/>

</ResourceDictionary>
