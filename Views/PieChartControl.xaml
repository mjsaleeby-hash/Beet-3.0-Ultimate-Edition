<UserControl x:Class="BeetsBackup.Views.PieChartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:BeetsBackup.Helpers">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- A visible keyboard focus ring for legend rows. WPF draws FocusVisualStyle on
             top of the control only when it has KEYBOARD focus, so mouse users see no
             change and layout is unaffected.
             NOTE: this deliberately duplicates AccentFocusVisual, which is stranded in
             MainWindow.xaml's Window.Resources and therefore unreachable from this
             UserControl. Promoting it to Themes/Controls.xaml (the app-wide dictionary
             merged in App.xaml) is queued for Wave 2.6, the de-dup wave — not done here,
             because moving a resource out of MainWindow is not this wave's risk to take. -->
        <Style x:Key="LegendRowFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-1" RadiusX="5" RadiusY="5"
                                   Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                   SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chrome-free button used as the legend row container. The template root is the
             same Border the row used when it was a plain Border, so CornerRadius, Padding
             and the hover/selection background all behave exactly as before — but the row
             is now focusable, activates on Space/Enter, and exposes the Invoke automation
             pattern that matches what clicking it does (navigate into that folder). -->
        <Style x:Key="GhostRowButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource LegendRowFocusVisual}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfaceBrush}">
        <!-- Empty state: select a drive or folder -->
        <StackPanel x:Name="SelectDriveOverlay" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Visible">
            <TextBlock Text="Select a drive or folder" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Main chart content -->
        <Grid x:Name="ChartContent" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Pie chart canvas -->
        <!-- The donut is a visual summary; the legend beside it is the accessible
             representation, because slice identity is carried by colour alone. Naming the
             container gives a screen reader one meaningful stop that points at the list,
             instead of an unlabelled canvas full of anonymous shapes. -->
        <Grid Grid.Column="0" Width="280" Height="280" Margin="24"
              AutomationProperties.Name="Space distribution chart"
              AutomationProperties.HelpText="Donut chart of the largest items. The same data is in the Space Distribution list, which is keyboard accessible.">
            <Canvas x:Name="PieCanvas" Width="280" Height="280"/>
            <!-- Center label -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock x:Name="TotalSizeText"
                           HorizontalAlignment="Center"
                           FontSize="20" FontWeight="Bold"
                           MaxWidth="88" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="total size"
                           HorizontalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
            <!-- Calculating overlay -->
            <Border x:Name="CalculatingOverlay" Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="140" Opacity="0.85" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#x23F3;" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Calculating sizes..." FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Chart will update as data arrives" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Legend -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Margin="0,16,16,16">
            <StackPanel>
                <TextBlock Text="Space Distribution" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                <TextBlock x:Name="SubtitleText" FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,12"/>
                <ItemsControl x:Name="LegendList" KeyboardNavigation.TabNavigation="Continue">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="LegendButton"
                                    Style="{StaticResource GhostRowButton}"
                                    Margin="0,1"
                                    Click="Legend_Click"
                                    MouseEnter="Legend_MouseEnter"
                                    MouseLeave="Legend_MouseLeave"
                                    GotKeyboardFocus="Legend_GotKeyboardFocus"
                                    LostKeyboardFocus="Legend_LostKeyboardFocus"
                                    AutomationProperties.Name="{Binding Announcement}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>

                                    <Rectangle Grid.Column="0" Width="12" Height="12" RadiusX="2" RadiusY="2">
                                        <Rectangle.Fill>
                                            <SolidColorBrush Color="{Binding FillColor}"/>
                                        </Rectangle.Fill>
                                    </Rectangle>

                                    <TextBlock Grid.Column="1" Text="{Binding Icon}" FontSize="13"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="13"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Column="3" Text="{Binding SizeDisplay}" FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                    <!-- Percentage uses PrimaryTextBrush, not the slice colour.
                                         All 11 palette colours fail WCAG 4.5:1 against light's
                                         #FFFFFF (measured 2.45-3.49); the colour association is
                                         already carried by the swatch in column 0, so painting
                                         the number too bought nothing and cost readability. -->
                                    <TextBlock x:Name="PctText" Grid.Column="4" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Text="{Binding Percentage, StringFormat={}{0:0.0}%}"/>
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                    <Setter TargetName="LegendButton" Property="Background"
                                            Value="{DynamicResource SelectionBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsNegligible}" Value="True">
                                    <Setter TargetName="PctText" Property="Foreground"
                                            Value="{DynamicResource SecondaryTextBrush}"/>
                                    <Setter TargetName="PctText" Property="FontWeight" Value="Normal"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
