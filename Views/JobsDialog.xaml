<Window x:Class="BeetsBackup.Views.JobsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scheduled Jobs"
        Width="640" Height="400"
        WindowStartupLocation="CenterOwner"
        FontSize="14"
        FontFamily="Segoe UI Variable, Segoe UI"
        Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Scheduled Backup Jobs"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}"/>

        <!-- Jobs list -->
        <ListView Grid.Row="2" x:Name="JobsList"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  Foreground="{DynamicResource PrimaryTextBrush}"
                  MouseDoubleClick="JobsList_MouseDoubleClick">
            <!-- Full ControlTemplate (not just setters) so the selection background actually paints.
                 The default theme ListViewItem template ignores a Background setter on selection and
                 draws its own pale highlight, so a Foreground="White" setter alone left white text on a
                 near-white highlight (unreadable). Mirrors MainWindow's ListViewItem: SelectionBrush
                 fill + accent left-border + readable primary text, consistent with the rest of the app. -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        BorderThickness="2,0,0,0" BorderBrush="Transparent"
                                        SnapsToDevicePixels="True">
                                    <GridViewRowPresenter Margin="0,2"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="140" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Source" Width="140" DisplayMemberBinding="{Binding SourcePathsDisplay}"/>
                    <GridViewColumn Header="Destination" Width="140" DisplayMemberBinding="{Binding DestinationPath}"/>
                    <GridViewColumn Header="Next Run" Width="140" DisplayMemberBinding="{Binding NextRun}"/>
                    <GridViewColumn Header="Recurring" Width="80" DisplayMemberBinding="{Binding IsRecurring}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Edit Selected"
                    Background="{DynamicResource PanelBrush}"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Padding="16,8" Margin="0,0,12,0" Cursor="Hand"
                    Click="Edit_Click"/>
            <Button Content="Delete Selected"
                    Background="{DynamicResource PanelBrush}"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Padding="16,8" Margin="0,0,12,0" Cursor="Hand"
                    Click="Delete_Click"/>
            <Button Content="Close"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White" BorderThickness="0"
                    Padding="16,8" Cursor="Hand"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
