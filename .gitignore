bin/
obj/
publish_out/
revert-features.sh
revert-transfer-modes.sh
*.user
*.suo
.vs/

# Local-only artifacts produced by running the app — not source content.
BeetsBackup-Diagnostics-*/
BeetsBackup_Log_*.csv

# Windows Event Log exports taken while investigating a crash. Machine-specific
# and mostly about OTHER processes, so they are evidence for one investigation,
# not project content. Findings belong in notes/bugs.md; the dump stays local.
Beets_Events_*.txt

# Scratch UI experiments kept locally; not part of the shipped app.
Test UI/

# Third-party design skills installed by `uipro init --ai claude`
# (npm: ui-ux-pro-max-cli). ~2.8 MB of vendor content, regenerable at any time by
# re-running that command, and mostly aimed at web stacks this desktop app doesn't
# use — only the wpf/winui stack tables are relevant here. Treated as local tooling
# like node_modules rather than project source.
# NOTE: scoped to skills/ deliberately — .claude/agents/ and .claude/settings.local.json
# ARE tracked and must stay that way.
.claude/skills/

# Throwaway git worktrees for isolated feature work (Wave 2.6 was built in one).
# A full second checkout of the repo — untracked before this entry, so a `git add -A`
# could have swept the whole thing in.
.claude/worktrees/

# Scratch workspace for plan-execution ledgers and review artifacts. Local bookkeeping;
# the git history is the durable record.
.superpowers/
