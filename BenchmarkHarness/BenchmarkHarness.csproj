<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BeetsBackup.Benchmark</AssemblyName>
    <RootNamespace>BeetsBackup.Benchmark</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <Version>1.0.0</Version>
    <Product>Beet's Backup Benchmark Harness</Product>
    <Company>Beet Software</Company>
    <Description>Drives repeatable backup scenarios against Beet for apples-to-apples 3.0 vs 4.0 comparison.</Description>
  </PropertyGroup>

  <!-- Reuse the PerfMon project's ingestors (BackupLog/Telemetry) and Beet data paths so
       the harness reads outcomes/telemetry the exact same way the cohort report does. -->
  <ItemGroup>
    <ProjectReference Include="..\PerformanceMonitor\BeetsBackup.PerfMon.csproj" />
  </ItemGroup>

</Project>
